          "id": "9abf71ba-abbe-4b26-97a9-4ca646149b29",
          "name": "Get Rijksstudio User Set Details",
          "request": {
            "name": "Get Rijksstudio User Set Details",
            "description": {
              "content": "Returns the full contents of a single Rijksstudio set, including the\nowner profile, set metadata, and the ordered list of set items\n(`setItems`) linking back to Collection API objects.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":culture",
                "usersets",
                ":setId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) The caller's Rijksstudio API key."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format. JSON is the default."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0",
                  "description": "Result page number (0-based) for the embedded `setItems` list."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "25",
                  "description": "Items per page for the embedded `setItems` list."
                }
              ],
              "variable": [
